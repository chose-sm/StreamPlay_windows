{
  "name": "streamplay",
  "productName": "StreamPlay",
  "version": "1.1.1",
  "description": "Mirror your Windows screen and system audio to a Chromecast / Android TV over Wi-Fi",
  "author": "Samuel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "notices": "node scripts/gen-notices.js",
    "release": "npm run notices && electron-builder --win nsis portable --x64 --publish never",
    "pack": "electron-builder --win dir --x64"
  },
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "sk.samuel.streamplay",
    "productName": "StreamPlay",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "LICENSE", "to": "LICENSE.txt" },
      { "from": "THIRD-PARTY-NOTICES.txt", "to": "THIRD-PARTY-NOTICES.txt" },
      { "from": "licenses", "to": "licenses" }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "StreamPlay",
      "include": "build/installer.nsh",
      "artifactName": "StreamPlay-Setup.exe"
    },
    "portable": {
      "artifactName": "StreamPlay-Portable.exe"
    }
  }
}
